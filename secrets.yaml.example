# Copia este archivo a `secrets.yaml` y rellena los valores.
# `secrets.yaml` está en .gitignore y NO debe commitearse.

# WiFi de tu red doméstica
wifi_ssid: "MiRedWifi"
wifi_password: "MiPasswordWifi"

# Modo AP de fallback (cuando no consigue conectar al WiFi)
wifi_ap_ssid: "Ambrosio-Setup"
wifi_ap_password: "configurar123"

# Encryption key del ESPHome native API. Debe coincidir con la del Ambrosierver.
# Generar con: openssl rand -base64 32
api_encryption_key: "GENERA_UNA_KEY_NUEVA_AQUI"

# IP (o hostname) del servidor Ambrosierver en tu LAN
ambrosierver_host: "192.168.1.X"
